{
  "name": "@quickstat/expressjs",
  "version": "0.0.4",
  "description": "Effortlessly monitor express.js rest metrics and export them to Prometheus for visualization in Grafana",
  "repository": {
    "type": "git",
    "url": "git://https://github.com/QuickStat/quickstat.git",
    "directory": "packages/plugins/expressjs"
  },
  "license": "Apache-2.0",
  "author": "DxLoop",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "npx rimraf ./dist",
    "lint": "eslint --format pretty .",
    "lint-fix": "bun run lint --quiet --fix",
    "release": "pnpm publish --no-git-check",
    "release:canary": "bash ../../.github/canary.sh && node ../../scripts/build.js canary && pnpm publish --no-git-check",
    "start": "tsup --watch",
    "test": "vitest --passWithNoTests",
    "typecheck": "tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@quickstat/core": "workspace:*",
    "@quickstat/rest": "workspace:*"
  },
  "devDependencies": {
    "@quickstat/eslint-config": "workspace:*",
    "@quickstat/ts-config": "workspace:*",
    "@quickstat/tsup-config": "workspace:*",
    "@types/express": "^4.17.21",
    "eslint": "^9.7.0",
    "express": "^4.19.2",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.1.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "rest",
    "api",
    "express.js",
    "express",
    "expressjs",
    "swagger",
    "request",
    "response",
    "service",
    "metrics",
    "monitor",
    "monitoring",
    "performance",
    "node.js",
    "plugin",
    "track",
    "tracking",
    "stats",
    "statistics",
    "analytics",
    "visualization",
    "dashboard",
    "grafana",
    "prometheus"
  ]
}
