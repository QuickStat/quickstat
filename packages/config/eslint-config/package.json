{
  "name": "@quickstat/eslint-config",
  "version": "1.1.8",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./legacy": {
      "import": "./dist/legacy.js",
      "require": "./dist/legacy.cjs",
      "default": "./dist/legacy.cjs"
    },
    "./flat": {
      "import": "./dist/flat.js",
      "require": "./dist/flat.cjs",
      "default": "./dist/flat.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist",
    "!/**/**.test.**",
    "!/**/__tests__/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "npx rimraf ./dist",
    "lint": "eslint --format pretty .",
    "lint-fix": "bun run lint --quiet --fix",
    "release": "pnpm publish --no-git-check",
    "release:canary": "bash ../../../.github/canary.sh && node ../../../scripts/build.js canary && pnpm publish --no-git-check",
    "start": "tsup --watch",
    "typecheck": "tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@eslint/js": "^9.7.0",
    "@types/eslint": "~8.56.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0-alpha.42",
    "@typescript-eslint/parser": "^8.0.0-alpha.49",
    "eslint-config-prettier": "~9.1.0",
    "eslint-config-turbo": "~2.0.6",
    "eslint-formatter-pretty": "^6.0.1",
    "eslint-plugin-eslint-plugin": "^6.2.0",
    "eslint-plugin-import": "~2.29.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-turbo": "~2.0.6",
    "eslint-plugin-unused-imports": "~4.0.0",
    "eslint-plugin-vitest": "~0.5.4",
    "eslint-plugin-vitest-globals": "~1.5.0",
    "globals": "^15.8.0"
  },
  "devDependencies": {
    "@quickstat/ts-config": "workspace:*",
    "@quickstat/tsup-config": "workspace:*",
    "eslint": "^9.7.0",
    "tsup": "^8.1.0",
    "typescript": "~5.4.5"
  },
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.1.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
