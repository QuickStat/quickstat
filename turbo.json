{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "clean": {
      "dependsOn": [
        "^clean"
      ],
      "outputs": [],
      "cache": false,
      "outputLogs": "new-only"
    },
    "start": {
      "dependsOn": [
        "^wait"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": false,
      "persistent": true
    },
    "wait": {
      "cache": false
    },
    "test": {
      "dependsOn": [],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "outputs": [],
      "cache": false
    },
    "lint-fix": {
      "outputs": [
        "src/**"
      ],
      "cache": false,
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "release": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "release:canary": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    }
  }
}
