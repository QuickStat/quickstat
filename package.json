{
  "name": "quickstat",
  "version": "0.0.0",
  "description": "QuickStat simplifies tracking for different libraries or even manual entries. Visualize data in Grafana, store in databases, or scrape via Prometheus.",
  "license": "Apache-2.0",
  "author": "DxLoop",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/datasources/*",
      "packages/plugins/*",
      "examples/*",
      "examples/plugins/*",
      "packages/config/eslint-config/*",
      "packages/config/tsup-config/*",
      "packages/config/ts-config/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "format": "bun run format:dprint",
    "format:dprint": "dprint fmt",
    "format:fix": "dprint fmt --incremental=false",
    "format:pack": "npx sort-package-json package.json packages/**/**/package.json",
    "format:prettier": "prettier --config ./configs/prettier.config.cjs --write .",
    "graph": "npx nx graph ",
    "install:csb": "corepack enable && pnpm install --frozen-lockfile",
    "lint": "eslint --format pretty",
    "lint:case": "npx case-police --fix",
    "lint:ci": "turbo run build && eslint --max-warnings 10 --format pretty",
    "lint:fix": "eslint --fix --format pretty && bun run lint:case",
    "lint:turbo": "turbo run lint",
    "version": "changeset version",
    "release": "changeset publish",
    "version:canary": "changeset version --snapshot canary",
    "release:canary": "changeset publish --no-git-tag",
    "start": "turbo run start",
    "test": "vitest run --config ./configs/vitest.config.ts --coverage",
    "test:bun": "bun test --preload ./configs/setup.ts",
    "test:vitest": "vitest run --config ./configs/vitest.config.ts",
    "test:watch": "vitest --config ./configs/vitest.config.ts",
    "typecheck": "turbo run typecheck --continue",
    "upgrade": "npx taze -r -w --exclude pnpm",
    "changeset": "changeset",
    "//changeset:beta:enter": "changeset pre enter beta",
    "//changeset:beta:exit": "changeset pre exit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.7",
    "@quickstat/eslint-config": "workspace:*",
    "@quickstat/ts-config": "workspace:*",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "bun-types": "^1.1.20",
    "dprint": "^0.45.1",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.3.0",
    "rimraf": "^5.0.9",
    "ts-node": "^10.9.2",
    "turbo": "^2.0.6",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.1.4"
  }
}
