{
  "name": "@quickstat/demo-plugins-pm2",
  "private": true,
  "version": "0.0.1",
  "description": "Demo",
  "repository": {
    "type": "git",
    "url": "git://https://github.com/QuickStat/quickstat.git",
    "directory": "examples/plugins/pm2"
  },
  "license": "Apache-2.0",
  "author": "DxLoop",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "clean": "npx rimraf ./dist",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint --format pretty .",
    "lint-fix": "bun run lint --quiet --fix",
    "start": "tsc --watch",
    "start:main": "node ./dist/main.js",
    "test": "vitest --passWithNoTests",
    "typecheck": "tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@quickstat/core": "workspace:*",
    "@quickstat/pm2": "workspace:*",
    "@quickstat/prometheus": "workspace:*",
    "pm2": "^5.3.1"
  },
  "devDependencies": {
    "@quickstat/eslint-config": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "^5.4.3"
  },
  "packageManager": "pnpm@8.3.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
