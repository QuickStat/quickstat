{
  "name": "@quickstat/demo-plugins-rest",
  "private": true,
  "version": "0.0.2",
  "description": "Demo",
  "repository": {
    "type": "git",
    "url": "git://https://github.com/QuickStat/quickstat.git",
    "directory": "examples/plugins/rest"
  },
  "license": "Apache-2.0",
  "author": "DxLoop",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "clean": "npx rimraf ./dist",
    "lint": "eslint --format pretty .",
    "lint-fix": "bun run lint --quiet --fix",
    "start": "tsc --watch",
    "start:general": "node ./dist/mainGeneral.js",
    "start:express": "node ./dist/mainExpress.js",
    "start:fastify": "node ./dist/mainFastify.js",
    "start:koa": "node ./dist/mainKoa.js",
    "test": "vitest --passWithNoTests",
    "typecheck": "tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@quickstat/core": "workspace:*",
    "@quickstat/expressjs": "workspace:*",
    "@quickstat/fastify": "workspace:*",
    "@quickstat/koa": "workspace:*",
    "@quickstat/prometheus": "workspace:*",
    "@quickstat/rest": "workspace:*",
    "express": "^4.19.2",
    "fastify": "^4.28.1",
    "koa": "^2.15.3",
    "koa-router": "^12.0.1"
  },
  "devDependencies": {
    "@quickstat/eslint-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/koa": "^2.15.0",
    "@types/koa-router": "^7.4.8",
    "eslint": "^9.7.0",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.1.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
